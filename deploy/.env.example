# Copy this file to deploy/.env and replace every value before starting Compose.
# Keep deploy/.env outside source control; it contains deployment secrets.
MYSQL_APP_USER=drilling
MYSQL_APP_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
DRILLING_CALLBACK_TOKEN=replace-with-a-long-random-service-token
# Optional host directory used by docker-compose.tls.example.yml.
# DRILLING_TLS_DIR=./tls
