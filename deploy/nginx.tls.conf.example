# Production Nginx site template. Copy to a mounted nginx configuration after
# installing a certificate and key. The active local-development nginx.conf
# intentionally listens on HTTP only so a fresh checkout can start without
# certificate files.
limit_req_zone $binary_remote_addr zone=drilling_api:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=drilling_conn:10m;

server {
  listen 80;
  server_name drilling.example.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name drilling.example.com;
  root /usr/share/nginx/html;
  client_max_body_size 2g;
  ssl_certificate /etc/nginx/tls/fullchain.pem;
  ssl_certificate_key /etc/nginx/tls/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_timeout 1d;
  add_header Strict-Transport-Security "max-age=31536000" always;

  location / { try_files $uri $uri/ /index.html; }
  location /api/algorithm/ {
    proxy_pass http://ruoyi-admin:80/api/algorithm/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    limit_req zone=drilling_api burst=40 nodelay;
    limit_conn drilling_conn 20;
    proxy_read_timeout 600s;
  }
  location /prod-api/ {
    proxy_pass http://ruoyi-admin:80/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    limit_req zone=drilling_api burst=40 nodelay;
    limit_conn drilling_conn 20;
    proxy_read_timeout 600s;
  }
}
