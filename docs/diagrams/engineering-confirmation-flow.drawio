<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="engineering-confirmation" name="工程评价配置确认逻辑"><mxGraphModel dx="1500" dy="1390" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1390"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="进入评价工作区／切换井场／参数变化&#10;页面重新获得焦点或测斜版本更新" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f8fafc;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="30" width="440" height="60" /></mxCell><mxCell id="eligible" value="处于评价工作区、有井场和计算权限，&#10;且非游客、无需修改初始密码？" style="rhombus;whiteSpace=wrap;html=0;fontSize=16;fillColor=#eff6ff;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="130" width="420" height="120" /></mxCell><mxCell id="quiet" value="不弹窗；离开工作区时关闭旧弹窗&#10;资料、配置、系统管理、纯预测页面不触发" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f8fafc;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="155" width="530" height="70" /></mxCell><mxCell id="read" value="读取服务端确认状态&#10;同一用户、井场的并发检查合并排队" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f8fafc;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="300" width="440" height="60" /></mxCell><mxCell id="current" value="响应仍属于当前用户、井场，&#10;且当前仍处于有效工作区？" style="rhombus;whiteSpace=wrap;html=0;fontSize=16;fillColor=#eff6ff;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="400" width="420" height="100" /></mxCell><mxCell id="stale" value="丢弃旧响应&#10;不得覆盖新井场状态或重新打开旧弹窗" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f8fafc;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="415" width="530" height="70" /></mxCell><mxCell id="loaded" value="确认状态读取成功？" style="rhombus;whiteSpace=wrap;html=0;fontSize=16;fillColor=#eff6ff;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="550" width="420" height="100" /></mxCell><mxCell id="failed" value="显示读取失败与“重新读取”入口，不弹空窗&#10;重试时重新读取；未经确认的计算仍由后端拦截" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f8fafc;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="555" width="530" height="90" /></mxCell><mxCell id="confirmed" value="当前登录会话、井场和参数内容&#10;已有确认记录？" style="rhombus;whiteSpace=wrap;html=0;fontSize=16;fillColor=#eff6ff;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="700" width="420" height="100" /></mxCell><mxCell id="ready" value="不弹窗&#10;允许继续提交评价或再规划任务" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f8fafc;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="715" width="530" height="70" /></mxCell><mxCell id="dialog" value="显示参数确认弹窗&#10;K → 不确定性模型与参数 → SF 公式" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f8fafc;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="850" width="440" height="75" /></mxCell><mxCell id="choice" value="核对后确认，还是修改参数？" style="rhombus;whiteSpace=wrap;html=0;fontSize=16;fillColor=#eff6ff;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="975" width="420" height="100" /></mxCell><mxCell id="config" value="进入系统配置修改参数&#10;配置页不弹窗；返回评价工作区时重新检查" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f8fafc;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="975" width="530" height="100" /></mxCell><mxCell id="post" value="提交当前参数指纹&#10;后端检查一致性与参数合法性，不计算轨迹" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f8fafc;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="1125" width="440" height="80" /></mxCell><mxCell id="posterror" value="参数已变化：重新读取并重新核对&#10;其他错误：保留弹窗，允许修改或重试" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f8fafc;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="1125" width="530" height="80" /></mxCell><mxCell id="saved" value="记录确认并关闭弹窗；无变化则结束&#10;请求期间发生的变化事件必须补查" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#f8fafc;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="1270" width="440" height="80" /></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="start" target="eligible"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="eligible" target="quiet"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="label1" value="否" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="159" width="25" height="24" /></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="eligible" target="read"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="label2" value="是" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="565" y="262" width="25" height="24" /></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="read" target="current"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="current" target="stale"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="label4" value="否" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="419" width="25" height="24" /></mxCell><mxCe