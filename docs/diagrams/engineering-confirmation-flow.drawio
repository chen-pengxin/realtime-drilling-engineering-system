=middle;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="565" y="1222" width="40" height="24" /></mxCell><mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;exitX=0.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="saved" target="read"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="140" y="1310" /><mxPoint x="140" y="330" /></Array></mxGeometry></mxCell><mxCell id="label15" value="仅有待处理的变化事件时" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="1272" width="175" height="24" /></mxCell></root></mxGraphModel></diagram></mxfile>